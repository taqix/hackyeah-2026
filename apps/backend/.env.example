# Optional. NestJS uses port 3000 and binds to all interfaces by default.
PORT=3000
# Optional. Override for local network setup if needed.
HOST=0.0.0.0

# Optional for health-only startup; both are required to call createPlan.
# Server-side only. Set a private API key and a model ID from AI Studio
# without the "models/" prefix. Never expose the key in a client environment.
GEMINI_API_KEY=
GEMINI_MODEL=
