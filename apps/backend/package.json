{
  "name": "@hackyeah/backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node --env-file-if-exists=.env ../../node_modules/@nestjs/cli/bin/nest.js start --watch",
    "build": "nest build",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint src test",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/*.mjs\"",
    "test": "node scripts/test.mjs",
    "prebuild": "npm run build --workspace=@hackyeah/contracts",
    "predev": "npm run build --workspace=@hackyeah/contracts",
    "pretest": "npm run build --workspace=@hackyeah/contracts",
    "pretypecheck": "npm run build --workspace=@hackyeah/contracts"
  },
  "engines": {
    "node": ">=22.9.0 <25"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "@hackyeah/contracts": "1.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.12",
    "@types/node": "22.18.6",
    "@typescript-eslint/eslint-plugin": "8.71.0",
    "@typescript-eslint/parser": "8.71.0",
    "eslint": "9.39.1",
    "prettier": "3.6.2",
    "typescript": "6.0.3"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/plans/create-plan.d.ts",
      "default": "./dist/plans/create-plan.js"
    }
  }
}
