{
  "compilerOptions": {
    "module": "NodeNext",
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "moduleResolution": "NodeNext",
    "types": [
      "node"
    ],
    "outDir": "./dist",
    "rootDir": "src",
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "declaration": true
  },
  "include": [
    "src/**/*.ts"
  ]
}
