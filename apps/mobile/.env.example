# Copy to apps/mobile/.env (ignored by Git) and fill in. Expo bundles every
# EXPO_PUBLIC_ value into the app, so only public values belong here: never a
# secret or service-role key. Restart `expo start` after changing this file.

# Required in supabase mode: the project URL, https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Required in supabase mode: the publishable key (sb_publishable_...) or the
# legacy anon key.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Optional: the product API base URL. Defaults to
# ${EXPO_PUBLIC_SUPABASE_URL}/functions/v1/product-api; set it to use a local
# `supabase functions serve`.
# EXPO_PUBLIC_PRODUCT_API_URL=http://192.168.1.10:54321/functions/v1/product-api

# Optional: supabase (default) or mock. mock runs the offline demo backend
# with Demo controls and needs none of the values above.
# EXPO_PUBLIC_API_MODE=mock

# Optional: development builds print [movo:*] debug logs (requests, auth,
# queries, navigation) to Metro and DevTools. Set to off to silence them.
# Release builds never log.
# EXPO_PUBLIC_DEBUG_LOGS=off
