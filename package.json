{
  "name": "hackyeah-2026",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test:supabase": "node --import tsx --test supabase/tests/*.test.mjs supabase/tests/*.test.ts",
    "typecheck:supabase": "tsc -p supabase/tsconfig.json",
    "lint:supabase": "eslint --config supabase/eslint.config.mjs supabase/functions supabase/tests supabase/scripts",
    "schema:product": "npm run build --workspace=@hackyeah/contracts && node --import tsx supabase/scripts/export-schema.ts",
    "start": "npm run start --workspace=@hackyeah/mobile",
    "start:hostname": "npm run start:hostname --workspace=@hackyeah/mobile --",
    "android": "npm run android --workspace=@hackyeah/mobile",
    "ios": "npm run ios --workspace=@hackyeah/mobile",
    "web": "npm run web --workspace=@hackyeah/mobile",
    "dev:website": "npm run dev --workspace=@hackyeah/website",
    "build:website": "npm run build --workspace=@hackyeah/website",
    "build:pages": "node scripts/build-pages.mjs",
    "preview:pages": "node scripts/preview-pages.mjs",
    "dev:backend": "npm run dev --workspace=@hackyeah/backend",
    "build:backend": "npm run build --workspace=@hackyeah/backend",
    "test:backend": "npm run test --workspace=@hackyeah/backend",
    "format:check": "npm run format:check --workspace=@hackyeah/backend",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "build:wearables": "npm run build --workspace=@hackyeah/contracts && npm run build --workspace=@hackyeah/wearable-data",
    "test:wearables": "npm run build:wearables && npm run test --workspace=@hackyeah/wearable-data",
    "pretypecheck": "npm run build:wearables",
    "format:wearables": "prettier --check \"packages/**/*.{ts,json,cjs}\" \"docs/features/wearable-extraction.md\"",
    "demo:wearables": "npm run build:wearables && node packages/wearable-data/examples/import-fit.ts",
    "build:plans": "npm run build --workspace=@hackyeah/backend",
    "test:plans": "npm run test --workspace=@hackyeah/backend",
    "typecheck:plans": "npm run typecheck --workspace=@hackyeah/backend"
  },
  "devDependencies": {
    "eslint": "9.39.5",
    "eslint-config-expo": "57.0.2",
    "prettier": "3.8.2"
  }
}
